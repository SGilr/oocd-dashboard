# Cloudflare Pages headers.
#
# The site is static, self contained and loads nothing from another origin: no
# third party fonts, no analytics library, no trackers. The Content Security
# Policy below says so, and will break the build's own pages if that ever stops
# being true, which is the point.
#
# Cloudflare Web Analytics, if it is enabled on the project, is injected by
# Cloudflare at the edge from static.cloudflareinsights.com and reports to
# cloudflareinsights.com. Both are named below. It sets no cookies. Remove those
# two entries if analytics is turned off.

/*
  Content-Security-Policy: default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; font-src 'self'; manifest-src 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Frame-Options: DENY

/data/*.csv
  Content-Type: text/csv; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

/data/*.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

# The weekly prison figures, read by /capacity at runtime.
#
# This has to come after the /data/*.json rule above, because both match and
# the last matching rule sets the value. The derived out of court tables change
# quarterly and an hour of edge cache is right for them. This file changes
# every Tuesday morning, and an hour of cache after a successful ingest is an
# hour of the panel showing last week's figure under this week's date.
#
# Only Cache-Control is restated. Content-Type and the CORS header come from
# the rule above, so there is no chance of either being set twice.
/data/prison-capacity.json
  Cache-Control: public, max-age=300, must-revalidate

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
