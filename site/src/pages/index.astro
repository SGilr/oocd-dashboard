---
import Layout from "../components/Layout.astro";
import TexturePatterns from "../components/TexturePatterns.astro";
import Figure from "../components/Figure.astro";
import { renderPlot, PLOT_BASE } from "../lib/plot";
import * as Plot from "@observablehq/plot";
import {
  DISPOSAL_SERIES,
} from "../lib/palette";
import {
  BASIS_LABELS,
  OUTCOME_SHORT_LABELS,
  defaultBasis,
  financialYears,
  forceYear,
  forces,
  latestYear,
  nationalQuarter,
  nationalYear,
  oocdSum,
  quarterDate,
  value,
} from "../lib/data";
import { compute, formatMeasure } from "../lib/measures";
import { OUTCOME_22_COMPULSORY_FROM } from "../lib/annotations";
import GeneralNotes from "../components/GeneralNotes.astro";

const basis = defaultBasis;
const variant = "all" as const;

const firstYear = financialYears[0];
const latestRow = nationalYear.rows.find((row) => row.fy === latestYear)!;
const firstRow = nationalYear.rows.find((row) => row.fy === firstYear)!;

const latestShare = compute("share_positive", latestRow, { basis, variant })!;
const firstShare = compute("share_positive", firstRow, { basis, variant })!;
const latestVolume = oocdSum(latestRow, basis, variant);
const latestOutcome22 = value(latestRow, basis, variant, "t22");
const outcome22Share = (latestOutcome22 / latestVolume) * 100;

// The spread across forces, reported as a range rather than as a ranking,
// because a single national number hides how differently forces behave.
const latestByForce = forceYear.rows
  .filter((row) => row.fy === latestYear)
  .map((row) => ({
    force: row.force as string,
    share: compute("share_positive", row, { basis, variant }),
  }))
  .filter((entry) => entry.share !== null)
  .sort((a, b) => (a.share as number) - (b.share as number));
const lowest = latestByForce[0];
const highest = latestByForce[latestByForce.length - 1];

const tiles = [
  {
    label: "Out of court share of positive outcomes",
    value: formatMeasure("share_positive", latestShare),
    note: `${latestYear}. Of every 100 cases closed with somebody held to account, ${latestShare.toFixed(0)} were dealt with outside court.`,
  },
  {
    label: "Out of court resolutions",
    value: latestVolume.toLocaleString("en-GB"),
    note: `${latestYear}, all 44 forces, on the ${BASIS_LABELS[basis].toLowerCase()} basis.`,
  },
  {
    label: "Change since " + firstYear,
    value: `${latestShare - firstShare >= 0 ? "+" : ""}${(latestShare - firstShare).toFixed(1)} pts`,
    note: `The share moved from ${firstShare.toFixed(1)} per cent in ${firstYear} to ${latestShare.toFixed(1)} per cent in ${latestYear}.`,
  },
  {
    label: "Range across the 44 forces",
    value: `${(lowest.share as number).toFixed(1)}% to ${(highest.share as number).toFixed(1)}%`,
    note: `Lowest ${lowest.force}, highest ${highest.force}, in ${latestYear}. The range is not a ranking, and the notes below apply.`,
  },
];

// --- Trend of the out of court share of positive outcomes ----------------
const trend = nationalQuarter.rows.map((row) => ({
  date: quarterDate(row.fy, row.q as number),
  fy: row.fy,
  q: row.q as number,
  share: compute("share_positive", row, { basis, variant }) ?? 0,
  oocd: oocdSum(row, basis, variant),
  positive: value(row, basis, variant, "positive"),
}));

const compulsoryFrom = quarterDate(OUTCOME_22_COMPULSORY_FROM, 1);
const trendStart = trend[0].date;

const trendPlot = renderPlot(
  {
    ...PLOT_BASE,
    width: 1120,
    height: 340,
    x: { type: "utc", label: null, grid: false, ticks: 6 },
    y: {
      label: null,
      grid: true,
      domain: [0, Math.min(100, Math.ceil(Math.max(...trend.map((d) => d.share)) / 10) * 10 + 10)],
      tickFormat: (d: number) => `${d}%`,
    },
    marks: [
      Plot.rect([{ x1: trendStart, x2: compulsoryFrom }], {
        x1: "x1",
        x2: "x2",
        y1: 0,
        y2: 100,
        fill: "var(--shade-band)",
        clip: true,
      }),
      Plot.ruleY([0], { stroke: "var(--rule-strong)" }),
      Plot.line(trend, {
        x: "date",
        y: "share",
        stroke: "var(--series-national)",
        strokeWidth: 2,
        curve: "monotone-x",
      }),
      Plot.dot(trend.filter((_, index) => index % 4 === 3), {
        x: "date",
        y: "share",
        r: 3,
        fill: "var(--series-national)",
        stroke: "var(--surface-1)",
        strokeWidth: 2,
      }),
    ],
  },
  {
    title: "National out of court share of positive outcomes by quarter",
    description: `From ${firstYear} to ${latestYear}. The shaded period runs to the end of ${OUTCOME_22_COMPULSORY_FROM.slice(0, 4)}/${Number(OUTCOME_22_COMPULSORY_FROM.slice(0, 4)) % 100}, before outcome 22 recording became compulsory.`,
  }
);

// --- Resolution mix over time ----------------------------------------------
const mix = nationalQuarter.rows.flatMap((row) =>
  DISPOSAL_SERIES.map((series) => ({
    date: quarterDate(row.fy, row.q as number),
    fy: row.fy,
    q: row.q as number,
    type: series.type,
    label: series.short,
    count: value(row, basis, variant, `t${series.type}`),
  }))
);

const mixPlot = renderPlot(
  {
    ...PLOT_BASE,
    width: 1120,
    height: 360,
    marginLeft: 68,
    x: { type: "utc", label: null, ticks: 6 },
    y: { label: null, grid: true, tickFormat: (d: number) => d.toLocaleString("en-GB") },
    color: {
      domain: DISPOSAL_SERIES.map((series) => series.type),
      range: DISPOSAL_SERIES.map((series) => `url(#tex-${series.type})`),
      legend: false,
    },
    marks: [
      Plot.areaY(mix, {
        x: "date",
        y: "count",
        z: "type",
        fill: "type",
        order: DISPOSAL_SERIES.map((series) => series.type),
        stroke: "var(--surface-1)",
        strokeWidth: 1,
      }),
      Plot.ruleY([0], { stroke: "var(--rule-strong)" }),
    ],
  },
  {
    title: "National out of court resolutions by type and quarter",
    description:
      "A stacked area chart. Community resolutions are the largest type throughout. Outcome 22 appears from 2019/20 and grows after recording became compulsory in 2021/22.",
  }
);

const mixTableRows = financialYears.map((fy) => {
  const row = nationalYear.rows.find((entry) => entry.fy === fy)!;
  const record: Record<string, string | number> = { fy };
  for (const series of DISPOSAL_SERIES) {
    record[`t${series.type}`] = value(row, basis, variant, `t${series.type}`).toLocaleString("en-GB");
  }
  record.total = oocdSum(row, basis, variant).toLocaleString("en-GB");
  return record;
});

// --- The youth share of cautions -------------------------------------------
// Outcome types 2 and 3 are the only age information in this collection, and
// together they are a complete age split of the caution route. That makes this
// the one age measure the published tables actually support.
//
// It is a share of cautions and never a share of out of court resolutions. The
// other four types carry no age at all, and in the latest year they are the
// large majority of the volume, so a youth share of resolutions would be a
// number put on something the data does not hold.
//
// National only, deliberately. The force figures are too small to carry a
// share: in 2025/26 the City of London issued 56 cautions, one of them to a
// youth, and North Wales 333 with 140 to youths, so a force level line would
// swing on single cases and read as a difference in policy.
const cautionAge = financialYears.map((fy) => {
  const row = nationalYear.rows.find((entry) => entry.fy === fy)!;
  const youth = value(row, basis, variant, "t2");
  const adult = value(row, basis, variant, "t3");
  const cautions = youth + adult;
  return {
    fy,
    year: Number(fy.slice(0, 4)),
    youth,
    adult,
    cautions,
    share: cautions > 0 ? (youth / cautions) * 100 : 0,
  };
});

const firstCautions = cautionAge[0];
const latestCautions = cautionAge[cautionAge.length - 1];
const fall = (from: number, to: number): number | null =>
  from > 0 ? ((from - to) / from) * 100 : null;
const youthFall = fall(firstCautions.youth, latestCautions.youth);
const cautionFall = fall(firstCautions.cautions, latestCautions.cautions);

// Drawn from zero. A share this flat would look like a collapse on a truncated
// axis, and the collapse in this series is in the counts, not in the share.
const cautionAgeCeiling =
  Math.ceil((Math.max(...cautionAge.map((point) => point.share)) + 1) / 5) * 5;

const cautionAgePlot = renderPlot(
  {
    ...PLOT_BASE,
    width: 1120,
    height: 320,
    x: {
      label: null,
      tickFormat: (d: number) => `${d}/${(d + 1) % 100}`,
      ticks: financialYears.length,
    },
    y: {
      label: null,
      grid: true,
      domain: [0, cautionAgeCeiling],
      tickFormat: (d: number) => `${d}%`,
    },
    marks: [
      Plot.ruleY([0], { stroke: "var(--rule-strong)" }),
      Plot.line(cautionAge, {
        x: "year",
        y: "share",
        stroke: "var(--series-national)",
        strokeWidth: 2.5,
        curve: "monotone-x",
      }),
      Plot.dot(cautionAge, {
        x: "year",
        y: "share",
        r: 3.5,
        fill: "var(--series-national)",
        stroke: "var(--surface-1)",
        strokeWidth: 2,
      }),
    ],
  },
  {
    title: "The youth share of cautions, nationally, by financial year",
    description:
      `The share of all cautions that were cautions of youths, from ` +
      `${firstCautions.share.toFixed(1)} per cent in ${firstYear} to ` +
      `${latestCautions.share.toFixed(1)} per cent in ${latestYear}. The line is ` +
      `drawn from zero.` +
      (cautionFall === null
        ? ""
        : ` Over the same period the number of cautions of every kind fell by ` +
          `about ${cautionFall.toFixed(0)} per cent.`),
  }
);
---

<Layout
  title="Overview"
  description="How the 43 territorial police forces of England and Wales, and British Transport Police, distribute recorded crime outcomes, and how much of that runs through out of court routes. Out of court resolutions, until recently called out of court disposals."
>
  <TexturePatterns />

  <h1>Out of court resolutions in England and Wales</h1>

  <p class="lede">
    This dashboard shows how the 43 territorial police forces of England and Wales,
    and British Transport Police, distribute their recorded crime outcomes, and how
    much of that distribution runs through out of court routes. It covers
    {firstYear} to {latestYear}, force by force, using one source: the Home Office
    police recorded crime and outcomes open data tables.
  </p>

  <p>
    It shows volume, share, mix and change over time. It says nothing about whether
    those decisions were right, consistent, proportionate or effective, because no
    published national dataset supports that claim. There is no record of what
    condition was attached to a resolution, whether the person engaged with it, or
    whether they completed it. The
    <a href="/methodology#what-this-dashboard-cannot-tell-you">methodology page sets out what this data cannot tell you</a>,
    and that section is worth reading before the charts.
  </p>

  <h2 class="visually-hidden">Headline figures</h2>
  <div class="tiles">
    {
      tiles.map((tile) => (
        <div class="tile">
          <p class="tile__label">{tile.label}</p>
          <p class="tile__value">{tile.value}</p>
          <p class="tile__note">{tile.note}</p>
        </div>
      ))
    }
  </div>

  <p class="small">
    Every figure on this page uses the count basis
    <strong>{BASIS_LABELS[basis].toLowerCase()}</strong>, includes fraud offences, and
    counts all six out of court resolution types. The
    <a href="/compare">compare page</a> lets you change each of those.
  </p>

  <Figure
    title="The out of court share of positive outcomes"
    subtitle={`National, ${firstYear} to ${latestYear}, by quarter. Basis: ${BASIS_LABELS[basis].toLowerCase()}.`}
    plot={trendPlot}
    description="Positive outcomes are charge or summons plus the six out of court resolution types. The share is the part of those that were dealt with outside court."
    notes={[
      "The shaded period runs before outcome 22 recording became compulsory in 2021/22, so part of the rise after that point is forces recording an outcome they were already using.",
    ]}
    annotationIds={["outcome-22-recording-change", "adults-and-children-counted-together"]}
    table={{
      caption: `National out of court share of positive outcomes by quarter, ${firstYear} to ${latestYear}`,
      columns: [
        { key: "period", label: "Quarter" },
        { key: "oocd", label: "Out of court resolutions", numeric: true },
        { key: "positive", label: "Positive outcomes", numeric: true },
        { key: "share", label: "Share", numeric: true },
      ],
      rows: trend.map((point) => ({
        period: `${point.fy} Q${point.q}`,
        oocd: point.oocd.toLocaleString("en-GB"),
        positive: point.positive.toLocaleString("en-GB"),
        share: `${point.share.toFixed(1)}%`,
      })),
    }}
  />

  <Figure
    title="The mix of out of court resolutions"
    subtitle={`National, ${firstYear} to ${latestYear}, by quarter. Basis: ${BASIS_LABELS[basis].toLowerCase()}.`}
    plot={mixPlot}
    description="Each band is one resolution type. Bands are filled with both a colour and a texture, so the six stay distinguishable in greyscale and in print."
    legend={DISPOSAL_SERIES.map((series) => ({ type: series.type, label: series.short }))}
    legendTitle="Resolution type"
    annotationIds={[
      "outcome-22-recording-change",
      "published-corrections-are-negative",
      "adults-and-children-counted-together",
    ]}
    table={{
      caption: `National out of court resolutions by type and financial year, ${firstYear} to ${latestYear}`,
      columns: [
        { key: "fy", label: "Financial year" },
        ...DISPOSAL_SERIES.map((series) => ({
          key: `t${series.type}`,
          label: series.short,
          numeric: true,
        })),
        { key: "total", label: "All six types", numeric: true },
      ],
      rows: mixTableRows,
    }}
  />

  <h2>Age</h2>
  <p>
    Age is not a field in this collection. The outcomes tables count offences rather
    than people, and they carry no date of birth and no age band. The only age
    information anywhere in them is built into two of the outcome types: a caution of
    a youth is outcome type 2 and a caution of an adult is outcome type 3. Penalty
    notices, cannabis or khat warnings, community resolutions and Outcome 22 are
    recorded the same way whoever received them.
  </p>
  <p>
    So there is one age measure this data supports, and it is narrow. Types 2 and 3
    are a complete split of the caution route, which makes the youth share of cautions
    a real figure. It is not a youth share of out of court resolutions, and it cannot
    be read as one. In {latestYear} the four types that carry no age were
    {((1 - latestCautions.cautions / latestVolume) * 100).toFixed(0)} per cent of all
    out of court resolutions.
  </p>

  <Figure
    title="The youth share of cautions"
    subtitle={`National, ${firstYear} to ${latestYear}, by financial year. Basis: ${BASIS_LABELS[basis].toLowerCase()}.`}
    plot={cautionAgePlot}
    description="Cautions of youths as a share of all cautions, which is outcome type 2 as a share of types 2 and 3 together. These two types are the only place age appears in this data."
    notes={[
      `The share is close to flat while the base under it falls away. Cautions of ` +
        `all kinds fell from ${firstCautions.cautions.toLocaleString("en-GB")} in ` +
        `${firstYear} to ${latestCautions.cautions.toLocaleString("en-GB")} in ` +
        `${latestYear}, and cautions of youths fell from ` +
        `${firstCautions.youth.toLocaleString("en-GB")} to ` +
        `${latestCautions.youth.toLocaleString("en-GB")}` +
        (youthFall === null ? "" : `, about ${youthFall.toFixed(0)} per cent`) +
        `. A steady share here does not mean a steady number of children.`,
      "This is a share of cautions, not of out of court resolutions. It says nothing " +
        "about the age of anyone given a community resolution, a penalty notice, a " +
        "cannabis or khat warning or an Outcome 22, because those types carry no age.",
      "Shown nationally and not by force. The smallest forces issue a few hundred " +
        "cautions a year and a handful to youths, so a force level share would move " +
        "on single cases.",
    ]}
    annotationIds={["adults-and-children-counted-together"]}
    table={{
      caption: `National cautions by age group and financial year, ${firstYear} to ${latestYear}`,
      columns: [
        { key: "fy", label: "Financial year" },
        { key: "youth", label: "Caution, youths", numeric: true },
        { key: "adult", label: "Caution, adults", numeric: true },
        { key: "cautions", label: "All cautions", numeric: true },
        { key: "share", label: "Youth share", numeric: true },
      ],
      rows: cautionAge.map((point) => ({
        fy: point.fy,
        youth: point.youth.toLocaleString("en-GB"),
        adult: point.adult.toLocaleString("en-GB"),
        cautions: point.cautions.toLocaleString("en-GB"),
        share: `${point.share.toFixed(1)}%`,
      })),
    }}
  />

  <GeneralNotes />

  <h2>Reading these numbers</h2>
  <p>
    The share of positive outcomes is the default measure because it comes closest to
    the decision under examination: given that somebody was going to be held to
    account, was the case sent to court or dealt with outside it. It is not a measure
    of how much crime a force resolves, and a higher share is not better or worse than
    a lower one. Two forces with the same share may be doing very different things,
    and the same force may be doing different things in different offence groups.
  </p>
  <p>
    Outcome 22 is the type to treat with most care. It was available for voluntary
    recording from April 2019 and compulsory from April 2021, so any comparison across
    forces before {OUTCOME_22_COMPULSORY_FROM} is comparing forces that recorded it
    with forces that did not. Some forces also restrict which resolutions they use as a
    matter of policy, which shows up as a fall in a series without any change in what
    officers are doing.
  </p>

  <h2>Forces</h2>
  <p>
    There is a page for each of the {forces.length} forces, showing its resolution mix,
    its trend against the national distribution and the notes that apply to it.
  </p>
  <ul class="force-index">
    {forces.map((force) => (
      <li><a href={`/force/${force.slug}`}>{force.name}</a></li>
    ))}
  </ul>
</Layout>
