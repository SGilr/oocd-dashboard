---
import "../styles/global.css";
import { buildInfo } from "../lib/data";

interface Props {
  title: string;
  description: string;
  /** Wider pages let tables use the full column. */
  wide?: boolean;
}

const { title, description, wide = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";

const nav = [
  { href: "/", label: "Overview" },
  { href: "/compare", label: "Compare forces" },
  { href: "/methodology", label: "Methodology" },
  { href: "/data", label: "Data" },
];

function current(href: string) {
  if (href === "/") return path === "/" ? "page" : undefined;
  return path === href || path.startsWith(`${href}/`) ? "page" : undefined;
}
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Out of Court Disposals Dashboard</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site).href} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='2' fill='%231f4e79'/%3E%3Crect x='3' y='8' width='2.5' height='5' fill='white'/%3E%3Crect x='6.75' y='5' width='2.5' height='8' fill='white'/%3E%3Crect x='10.5' y='3' width='2.5' height='10' fill='white'/%3E%3C/svg%3E"
    />
  </head>
  <body class={wide ? "wide" : ""}>
    <a class="skip-link" href="#main">Skip to the content</a>

    <header class="site-header">
      <div class="shell">
        <div class="masthead">
          <p class="masthead__title">
            <span class="masthead__org">Oxon Advisory</span>
            <a href="/">Out of Court Disposals Dashboard</a>
          </p>
          <nav class="site-nav" aria-label="Sections">
            <ul>
              {
                nav.map((item) => (
                  <li>
                    <a href={item.href} aria-current={current(item.href)}>
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </div>
    </header>

    <main id="main">
      <div class="shell">
        {
          buildInfo.isFixture && (
            <div class="banner banner--alarm" role="alert">
              <strong>These figures are not real.</strong>
              <p>
                This build was made from synthetic fixture data generated by
                <code>etl/make_fixtures.py</code>, so that the site could be built and
                reviewed before the extract was run against the published files. Nothing
                on any page is a police recorded crime statistic. Do not cite it, quote it
                or screenshot it.
              </p>
            </div>
          )
        }
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="shell">
        <div class="footer-grid">
          <div>
            <h2>Produced by</h2>
            <p>
              Oxon Advisory, for a symposium on out of court disposals convened with
              De Montfort University and the East Midlands Policing Academic
              Collaboration.
            </p>
          </div>
          <div>
            <h2>Data licence</h2>
            <p>
              Contains public sector information licensed under the
              <a href="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/">
                Open Government Licence v3.0</a
              >. Source: Home Office, police recorded crime and outcomes open data
              tables.
            </p>
          </div>
          <div>
            <h2>This build</h2>
            <p>
              Data provenance: {buildInfo.provenance}. Built {buildInfo.builtAt.slice(0, 10)}.
              <a href="/data">Download the derived tables</a> or read the
              <a href="/methodology">methodology</a>.
            </p>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
